[2025-03-14T00:37:39.256+0000] {sql.py:295} INFO - Executing: 
INSERT INTO aggregated_binance_btcusdt 
(start_id, aggregation_period, ticker, start_timestamp, trade_conditions, 
number_of_trades, total_volume, average_volume, average_price, maximum_price, 
minimum_price, opening_price, closing_price)
SELECT 
    MIN(id) AS start_id,
    60 AS aggregation_period, 
    ticker,
    MIN(timestamp) AS start_timestamp,
    JSON_ARRAYAGG(trade_conditions) AS trade_conditions,
    COUNT(id) AS number_of_trades,
    SUM(volume) AS total_volume,
    AVG(volume) AS average_volume,
    AVG(price) AS average_price,
    MAX(price) AS maximum_price,
    MIN(price) AS minimum_price,
    (SELECT price FROM cleaned_binance_btcusdt ORDER BY timestamp ASC LIMIT 1) AS opening_price,
    (SELECT price FROM cleaned_binance_btcusdt ORDER BY timestamp DESC LIMIT 1) AS closing_price
FROM cleaned_binance_btcusdt
WHERE timestamp >= NOW() - INTERVAL 60 MINUTE
GROUP BY ticker;
